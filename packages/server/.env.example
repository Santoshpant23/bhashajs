# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────
# Local dev: mongodb://localhost:27017/bhashajs
# Docker:    mongodb://root:changeme@localhost:27017/bhashajs?authSource=admin
MONGO_CONNECTION_URL=mongodb://localhost:27017/bhashajs

# ─── Auth ─────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters — the server REFUSES to boot on a
# short or well-known placeholder secret. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-chars-openssl-rand-hex-32
JWT_EXPIRY=7d

# ─── CORS ─────────────────────────────────────────────
# Dev: * (allow all, no credentials). Prod: a comma-separated allowlist, e.g.
#   https://bhashajs.com,https://app.bhashajs.com  (credentials enabled only then)
CORS_ORIGIN=*

# ─── Migrations ───────────────────────────────────────
# DB migrations mutate prod data and only run when explicitly opted in. Leave
# unset/false for normal boots; set to true for ONE boot (after a backup) to
# apply a pending migration.
# RUN_MIGRATIONS=true

# ─── AI Provider ──────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Default per-project monthly AI translation cap (keys/month). New projects get
# this as their aiMonthlyCap. When a project's keys-translated-this-month would
# exceed its cap, /ai-translate and /generate-voice refuse with HTTP 429 so a
# single project can't run up the model bill. Falls back to 5000 if unset.
AI_MONTHLY_CAP_DEFAULT=5000

# Option A — AI Studio API key (simplest; free-tier rate limits apply).
#   Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Option B — Vertex AI (recommended for production: bills to your GCP project /
#   credits, service-account auth). When GEMINI_USE_VERTEX=true, GEMINI_API_KEY
#   is ignored. Mount the service-account JSON and point ADC at it.
# GEMINI_USE_VERTEX=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/sa.json

# ─── Docker only ──────────────────────────────────────
MONGO_ROOT_PASSWORD=changeme
