# ─── Required ────────────────────────────────────────
# Must be at least 32 characters — the server refuses to boot otherwise.
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-chars-openssl-rand-hex-32

# ─── AI: pick ONE of the two paths below ─────────────
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
# Path A — AI Studio API key (simplest). Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Path B — Vertex AI (production; uses your GCP credit, service-account auth).
# When GEMINI_USE_VERTEX=true, GEMINI_API_KEY is ignored.
# GEMINI_USE_VERTEX=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/sa.json

# Default per-project monthly AI translation cap (keys/month). New projects get
# this as aiMonthlyCap; /ai-translate and /generate-voice return 429 once a
# project would exceed it for the month. Falls back to 5000 if unset.
AI_MONTHLY_CAP_DEFAULT=5000

# ─── Self-host: public domain ───────────────────────
# The domain Caddy serves the dashboard on. Caddy provisions a Let's Encrypt
# certificate for it automatically on first boot (DNS must point at this server).
# Leave unset to serve on `localhost` with a locally-trusted cert for testing.
DOMAIN=your-domain.com

# ─── Optional (defaults shown) ──────────────────────
JWT_EXPIRY=7d
# Comma-separated list. Include marketing site, dashboard, and any local dev origins.
CORS_ORIGIN=https://bhashajs.com,https://app.bhashajs.com
# DB migrations only run when explicitly opted in (they mutate prod data). Leave
# unset for normal boots; set true for ONE boot, after a backup, to apply one.
# RUN_MIGRATIONS=true

# ─── Email (for invite delivery) ──────────────────────────────
# Recommended: Resend (3000/mo free) — sign up at https://resend.com
# Once verified, your DNS is set, the SMTP creds look like:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=re_your_resend_api_key
# Any SMTP provider works (Postmark, SendGrid, Gmail, AWS SES, etc.).
# If left blank, invite emails are logged to the server console instead of sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BhashaJS <noreply@bhashajs.com>

# Public URL where the dashboard lives — used to build invite links in emails.
APP_URL=https://app.bhashajs.com

# Generate a strong password for production!
MONGO_ROOT_PASSWORD=changeme
