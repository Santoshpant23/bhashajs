# ─── Required ────────────────────────────────────────
# Must be at least 32 characters — the server refuses to boot otherwise.
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-chars-openssl-rand-hex-32

# ─── AI: pick ONE of the two paths below ─────────────
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
# Path A — AI Studio API key (simplest). Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Path B — Vertex AI (production; uses your GCP credit, service-account auth).
# When GEMINI_USE_VERTEX=true, GEMINI_API_KEY is ignored.
# GEMINI_USE_VERTEX=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/sa.json

# Default per-project monthly AI translation cap (keys/month). New projects get
# this as aiMonthlyCap; /ai-translate and /generate-voice return 429 once a
# project would exceed it for the month. Falls back to 5000 if unset.
AI_MONTHLY_CAP_DEFAULT=5000

# Wider AI-cost guardrails for a SHARED (hosted) deployment — these bound your
# total Google Vertex/Gemini bill on the forever-free service. Both default ON.
#   AI_ACCOUNT_MONTHLY_CAP — one account's TOTAL AI keys/month across ALL its
#     projects (stops a user multiplying free AI by creating many projects).
#   AI_GLOBAL_MONTHLY_CAP  — instance-wide monthly ceiling across ALL projects:
#     the hard kill-switch. When hit, new AI generation pauses for everyone until
#     next month (existing translations keep serving).
# SELF-HOSTING with your own Gemini/Vertex key? You pay your own bill, so set
# BOTH to 0 to disable them (unlimited). MAX_PROJECTS_PER_USER caps projects per
# account (0 disables).
AI_ACCOUNT_MONTHLY_CAP=5000
AI_GLOBAL_MONTHLY_CAP=100000
MAX_PROJECTS_PER_USER=50

# ─── Self-host: public domain ───────────────────────
# The domain Caddy serves the dashboard on. Caddy provisions a Let's Encrypt
# certificate for it automatically on first boot (DNS must point at this server).
# LEFT UNSET ON PURPOSE → serves on `localhost` with a locally-trusted cert so the
# stack works out of the box. UNCOMMENT + set your real domain for public HTTPS
# (a placeholder like your-domain.com makes Caddy fail to get a certificate).
# DOMAIN=app.example.com

# ─── Optional (defaults shown) ──────────────────────
JWT_EXPIRY=7d
# Comma-separated list. Include marketing site, dashboard, and any local dev origins.
CORS_ORIGIN=https://bhashajs.com,https://app.bhashajs.com
# DB migrations only run when explicitly opted in (they mutate prod data). Leave
# unset for normal boots; set true for ONE boot, after a backup, to apply one.
# RUN_MIGRATIONS=true

# ─── Email (for invite delivery) ──────────────────────────────
# Recommended: Resend (3000/mo free) — sign up at https://resend.com
# Once verified, your DNS is set, the SMTP creds look like:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=re_your_resend_api_key
# Any SMTP provider works (Postmark, SendGrid, Gmail, AWS SES, etc.).
# If left blank, invite emails are logged to the server console instead of sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BhashaJS <noreply@bhashajs.com>

# Public URL where YOUR dashboard lives — used to build invite links in emails.
# Self-host: set this to your own dashboard URL (e.g. https://app.example.com),
# NOT the hosted app.bhashajs.com, or invites will link to the wrong place.
APP_URL=https://app.example.com

# Generate a strong password for production!
MONGO_ROOT_PASSWORD=changeme
